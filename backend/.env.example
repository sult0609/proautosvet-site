# Скопируйте этот файл в .env (без .example на конце) и впишите реальные
# значения. Файл .env НИКОГДА не должен попадать в git/GitHub — он уже
# добавлен в .gitignore рядом.

AMOCRM_SUBDOMAIN=proavtosvet
AMOCRM_TOKEN=впишите_сюда_ваш_долгосрочный_токен
ALLOWED_ORIGIN=https://proavtosvet-patsha.kz
PORT=5000
